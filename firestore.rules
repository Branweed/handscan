rules_version = '2';
// Paste this into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return hasProfile() && profile().role == 'admin'; }
    function isDriver() { return hasProfile() && profile().role == 'driver' && profile().active == true; }
    // A run is shared by every driver on the truck it was sent to.
    function onRun(data) { return request.auth.uid in data.driverIds; }
    function ownsManifest(mid) {
      return onRun(get(/databases/$(database)/documents/manifests/$(mid)).data);
    }

    // People. Only the office can create or change accounts' roles.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Trucks: drivers see the list on the sign-in screen; only the office changes it.
    match /trucks/{code} { allow read: if true; allow write: if isAdmin(); }
    match /driverLogins/{uid} { allow read, write: if isAdmin(); }

    // Runs (one per truck per day, holding one or more Metrc manifests).
    // Drivers sign in with just a truck name (no password), so runs can be read without an account.
    // Without an account they can only mark stops finished and add scans; the office does everything else.
    match /manifests/{mid} {
      function run() { return get(/databases/$(database)/documents/manifests/$(mid)).data; }
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stopsDone', 'status', 'updatedAt'])
            && resource.data.status in ['assigned', 'in_progress', 'done']
            && request.resource.data.status in ['assigned', 'in_progress', 'done']);

      // Scans: anyone with the app can add one to a live run (never edit or delete); it must name that run's truck.
      match /scans/{sid} {
        allow read: if true;
        allow create: if isAdmin()
          || (request.resource.data.keys().hasOnly(['tag', 'stopId', 'result', 'at', 'via', 'truck', 'driverName', 'otherStopId', 'raw', 'syncedAt'])
              && request.resource.data.tag is string && request.resource.data.tag.size() <= 64
              && request.resource.data.result in ['match', 'duplicate', 'wrong_stop', 'not_on_manifest']
              && request.resource.data.truck == run().truck
              && run().status in ['assigned', 'in_progress', 'done']
              && (!('driverName' in request.resource.data) || (request.resource.data.driverName is string && request.resource.data.driverName.size() <= 80)));
        allow update, delete: if isAdmin();
      }
    }
  }
}
