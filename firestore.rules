rules_version = '2';
// Paste this into Firebase console → Firestore Database → Rules, then Publish.
//
// Who can see what:
//   • Office admins (username + password): everything.
//   • Phones with the app (invisible Anonymous sign-in): runs, scans and the truck list. Drivers pick their name, then a truck.
//   • Note: anyone who opens the app link can see runs (no PIN). Not signed in at all: nothing.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return hasProfile() && profile().role == 'admin'; }
    // Any phone with the app is signed in invisibly ("Anonymous"); drivers just pick their name and truck — no PIN.
    function approvedPhone() { return signedIn(); }
    function canSeeRuns() { return isAdmin() || approvedPhone(); }

    // Office accounts. Only the office can create or change them.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Trucks: signed-in phones see them; only the office changes them.
    // trucks/_drivers is the name list on the sign-in screen, so any phone can read it (names only).
    match /trucks/{code} { allow read: if canSeeRuns() || (code == '_drivers' && signedIn()); allow write: if isAdmin(); }

    // Runs. Phones can only mark stops (and the load check) finished and add scans; the office does everything else.
    match /manifests/{mid} {
      function run() { return get(/databases/$(database)/documents/manifests/$(mid)).data; }
      allow read: if canSeeRuns();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (approvedPhone()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stopsDone', 'status', 'updatedAt'])
            && resource.data.status in ['assigned', 'in_progress', 'done']
            && request.resource.data.status in ['assigned', 'in_progress', 'done']);

      // Scans: an approved phone can add one to a live run (never edit or delete); it must name that run's truck.
      match /scans/{sid} {
        allow read: if canSeeRuns();
        allow create: if isAdmin()
          || (approvedPhone()
              && request.resource.data.keys().hasOnly(['tag', 'stopId', 'result', 'at', 'via', 'truck', 'driverName', 'otherStopId', 'raw', 'syncedAt'])
              && request.resource.data.tag is string && request.resource.data.tag.size() <= 64
              && request.resource.data.result in ['match', 'duplicate', 'wrong_stop', 'not_on_manifest']
              && request.resource.data.truck == run().truck
              && run().status in ['assigned', 'in_progress', 'done']
              && (!('driverName' in request.resource.data) || (request.resource.data.driverName is string && request.resource.data.driverName.size() <= 80)));
        allow update, delete: if isAdmin();
      }
    }
  }
}
