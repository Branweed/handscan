rules_version = '2';
// Paste this into Firebase console → Firestore Database → Rules, then Publish.
//
// Who can see what:
//   • Office admins (username + password): everything.
//   • Signed-in phones: runs, scans and the truck list. A phone signs in invisibly (Firebase "Anonymous" sign-in);
//     then a driver picks their name and enters their own PIN. The first time, they use the company PIN and pick their own.
//   • Anyone else (someone who only has the link): nothing.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return hasProfile() && profile().role == 'admin'; }
    function approvedPhone() { return signedIn() && exists(/databases/$(database)/documents/devices/$(request.auth.uid)); }
    function canSeeRuns() { return isAdmin() || approvedPhone(); }

    // Office accounts. Only the office can create or change them.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    match /driverLogins/{uid} { allow read, write: if isAdmin(); }

    // The company code: only the office can read or change it. (Rules can still compare against it below.)
    match /settings/access { allow read, write: if isAdmin(); }

    function myDevice() { return get(/databases/$(database)/documents/devices/$(request.auth.uid)).data; }
    function pinDoc(who) { return /databases/$(database)/documents/pins/$(who); }

    // Signed-in phones: one per phone, saying which driver is signed in on it ("who").
    // A driver signs in with THEIR OWN PIN. Only a driver who hasn't made a PIN yet can use the office code
    // (that's the first time); after that the office code no longer works for them.
    match /devices/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['who', 'name', 'at', 'code', 'pin'])
        && request.resource.data.who is string && request.resource.data.who.size() > 0 && request.resource.data.who.size() <= 80
        && (
          (!exists(pinDoc(request.resource.data.who))
            && 'code' in request.resource.data
            && exists(/databases/$(database)/documents/settings/access)
            && request.resource.data.code == get(/databases/$(database)/documents/settings/access).data.code)
          || ('pin' in request.resource.data
            && exists(pinDoc(request.resource.data.who))
            && request.resource.data.pin == get(pinDoc(request.resource.data.who)).data.pin)
        );
      allow delete: if isAdmin();
    }

    // Each driver's own PIN. Made by the driver right after their first sign-in; changed only by a phone signed in
    // with the current PIN. The office can see who has one and reset it (delete), but the app never shows PINs.
    match /pins/{who} {
      allow read, delete: if isAdmin();
      allow create: if approvedPhone() && myDevice().who == who
        && request.resource.data.keys().hasOnly(['pin', 'at'])
        && request.resource.data.pin is string && request.resource.data.pin.matches('^[0-9]{4,6}$');
      allow update: if approvedPhone() && myDevice().who == who
        && ('pin' in myDevice()) && myDevice().pin == resource.data.pin
        && request.resource.data.keys().hasOnly(['pin', 'at'])
        && request.resource.data.pin is string && request.resource.data.pin.matches('^[0-9]{4,6}$');
    }

    // Trucks: signed-in phones see them; only the office changes them.
    // trucks/_drivers is the name list on the sign-in screen, so any phone can read it (names only).
    match /trucks/{code} { allow read: if canSeeRuns() || (code == '_drivers' && signedIn()); allow write: if isAdmin(); }

    // Runs. Phones can only mark stops (and the load check) finished and add scans; the office does everything else.
    match /manifests/{mid} {
      function run() { return get(/databases/$(database)/documents/manifests/$(mid)).data; }
      allow read: if canSeeRuns();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (approvedPhone()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stopsDone', 'status', 'updatedAt'])
            && resource.data.status in ['assigned', 'in_progress', 'done']
            && request.resource.data.status in ['assigned', 'in_progress', 'done']);

      // Scans: an approved phone can add one to a live run (never edit or delete); it must name that run's truck.
      match /scans/{sid} {
        allow read: if canSeeRuns();
        allow create: if isAdmin()
          || (approvedPhone()
              && request.resource.data.keys().hasOnly(['tag', 'stopId', 'result', 'at', 'via', 'truck', 'driverName', 'otherStopId', 'raw', 'syncedAt'])
              && request.resource.data.tag is string && request.resource.data.tag.size() <= 64
              && request.resource.data.result in ['match', 'duplicate', 'wrong_stop', 'not_on_manifest']
              && request.resource.data.truck == run().truck
              && run().status in ['assigned', 'in_progress', 'done']
              && (!('driverName' in request.resource.data) || (request.resource.data.driverName is string && request.resource.data.driverName.size() <= 80)));
        allow update, delete: if isAdmin();
      }
    }
  }
}
